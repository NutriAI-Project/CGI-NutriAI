# ============================================================
# NutriAI API Gateway - Environment Variables
# ============================================================

APP_NAME="NutriAI API Gateway"
JWT_SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256

# Downstream service URLs
AUTH_SERVICE_URL=http://localhost:8001
DOCUMENT_SERVICE_URL=http://localhost:8002
DIET_SERVICE_URL=http://localhost:8003
HEALTH_SERVICE_URL=http://localhost:8004
NOTIFICATION_SERVICE_URL=http://localhost:8005
PROFILE_SERVICE_URL=http://localhost:8006
ADMIN_SERVICE_URL=http://localhost:8007

# Database (for health check only)
DATABASE_URL=postgresql://nutriai_user:nutriai_password@localhost:5432/nutriai
